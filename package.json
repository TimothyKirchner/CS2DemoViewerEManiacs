{
  "name": "strat-scope-desktop",
  "productName": "Strat Scope",
  "version": "1.1.1",
  "description": "Offline CS2 tactical demo viewer for Windows",
  "author": "Strat Scope",
  "private": true,
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.stratscope.desktop",
    "productName": "Strat Scope",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraFiles": [
      "README.txt",
      "ANALYSIS.md",
      "FEATURE_VERIFICATION.md",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Strat-Scope-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
